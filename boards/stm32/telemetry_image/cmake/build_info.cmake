# Writes tlm_build_info.h with the git commit of the source tree. Run at every
# build (not only at configure time) so the banner never shows an old hash.
# The file is rewritten only when its content changes.
execute_process(COMMAND git -C "${REPO_ROOT}" rev-parse --short=12 HEAD
                OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0 OR hash STREQUAL "")
  set(hash "unknown")
else()
  execute_process(COMMAND git -C "${REPO_ROOT}" status --porcelain --untracked-files=no
                  OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT dirty STREQUAL "")
    set(hash "${hash}-dirty")
  endif()
endif()
set(text "/* Generated by cmake/build_info.cmake. Do not edit. */\n#define TLM_GIT_COMMIT \"${hash}\"\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
